# Google AI Studio key — Gemini generateContent.
# Stitch project APIs need a key from stitch.withgoogle.com/settings (OAuth principal).
GOOGLE_API_KEY=
GEMINI_API_KEY=
STITCH_API_KEY=

# Set to `off` to hide the one-tap demo accounts on the sign-in page. Leave it
# unset while this is a demo; set it before the centre signs in for real, or
# anybody can sign in as the manager.
VITE_DEMO_LOGINS=

# Keyed hash for OTP challenges. Unset falls back to a development constant —
# set this before the centre runs for real, or anyone who can read the
# otp_challenges table can invert every code in it.
OTP_SECRET=

# Return the OTP in the API response so sign-up works without an SMS
# transport. On by default outside production; set to 0 to force it off, or 1
# to keep a staged demo working. Never 1 on a public deployment.
OTP_ECHO=

# ---------------------------------------------------------------------------
# payOS — online payment (optional). Without all three the app runs exactly as
# before: cash, card and bank transfer at the desk, and no "Pay online" button
# anywhere. Never prefix these with VITE_ — that would ship the checksum key to
# the browser.
# ---------------------------------------------------------------------------
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# ---------------------------------------------------------------------------
# Email — how an OTP reaches a person.
#
# MAIL_TRANSPORT=ethereal  asks nodemailer for a throwaway inbox and prints the
#                          sign-in details plus a link to each message. No
#                          signup, nothing delivered to real addresses. Use this
#                          for development.
# SMTP_* set               real delivery; takes precedence over ethereal.
# Neither                  the code is logged to the server console only.
# ---------------------------------------------------------------------------
MAIL_TRANSPORT=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ---------------------------------------------------------------------------
# Where the embedded database keeps itself, when there is no DATABASE_URL.
#
# Default: `.pglite` — data survives a dev-server restart. This matters for
# more than convenience: document counters live in this database, and a counter
# that resets walks the payOS order sequence back over codes payOS has already
# seen, which stops every payment link being issued.
#
# Set to `memory` for a deliberately throwaway run.
# ---------------------------------------------------------------------------
PGLITE_DATA_DIR=
